{
  "env": {
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }]
  },
  "ignorePatterns": [
    "dist/*"
  ],
  "overrides": [
    {
      "files": ["tools/**"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/**"],
      "env": {
        "browser": true
      }
    }
  ]
}
